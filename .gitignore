# Environment & Local Overrides
.env
.env.*
config/*.local.php
!config/*.local.php.example

# Runtime Caches & Dynamic Data
cache/*.json
!cache/.htaccess
*.log

# Backups & Temporary Files
backups/
*.tmp
*.bak
Thumbs.db
.DS_Store
__pycache__/
*.pyc

# Large Documentation Archives & Media Files
docs/*
!docs/CHANGELOG.txt
